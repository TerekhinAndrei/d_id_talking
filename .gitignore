# Backend Protection - DO NOT MODIFY
# These files are protected and should not be changed

# Core backend files - PROTECTED
app/main.py
app/core/config.py
app/core/base.py
app/core/factory.py
app/core/interfaces.py

# API endpoints - PROTECTED
app/api/v1/api.py
app/api/v1/endpoints/*.py

# Services - PROTECTED
app/services/*.py

# Models - PROTECTED
app/models/*.py

# Environment files
.env
.env.local
.env.production

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Uploads
uploads/

# Test files
test_files/ 